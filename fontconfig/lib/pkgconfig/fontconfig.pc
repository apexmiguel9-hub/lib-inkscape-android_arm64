localstatedir=/home/runner/work/lib-inkscape-android_arm64/lib-inkscape-android_arm64/.work/staging/fontconfig/var
confdir=/home/runner/work/lib-inkscape-android_arm64/lib-inkscape-android_arm64/.work/staging/fontconfig/etc/fonts
